+++ b/internal/runtime/executor/helps/codex_output_text_observation_test.go
@@ -0,0 +1,53 @@
+package helps
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	log "github.com/sirupsen/logrus"
+)
+
+func TestBridgeOutputTextObservationMonotonicAndPrivate(t *testing.T) {
+	t.Setenv("CLAUDE_CODEX_STREAM_DIAGNOSTICS", "1")
+	hook := &observationHook{}
+	logger := log.StandardLogger()
+	old := logger.ReplaceHooks(make(log.LevelHooks))
+	defer logger.ReplaceHooks(old)
+	logger.AddHook(hook)
+	d := NewCodexStreamObservation()
+	d.Observe([]byte(`data: {"type":"response.created","metadata":{"private":"` + observationSecret + `"}}`))
+	d.Emit(context.Background(), "stream", "eof", nil)
+	d.Observe([]byte(`data: {"type":"response.content_part.added","part":{"type":"output_text","text":""}}`))
+	d.Emit(context.Background(), "stream", "eof", nil)
+	d.Observe([]byte(`data: {"type":"response.output_text.delta","delta":"` + observationSecret + `"}`))
+	d.Observe([]byte(`data: {"type":"response.output_text.delta","delta":""}`))
+	d.Emit(context.Background(), "stream", "eof", nil)
+	entries := hook.snapshot()
+	if len(entries) != 3 {
+		t.Fatal("the owned text observations were not emitted")
+	}
+	for i, want := range []string{"none", "empty_only", "nonempty"} {
+		if !strings.Contains(entries[i].Message, "output_text_state="+want) || strings.Contains(entries[i].Message, observationSecret) {
+			t.Fatal("output state changed backwards or exposed text")
+		}
+	}
+}
+
+func TestBridgeOutputTextObservationTypedSnapshots(t *testing.T) {
+	t.Setenv("CLAUDE_CODEX_STREAM_DIAGNOSTICS", "1")
+	for _, tc := range []struct{ data, want string }{
+		{`{"type":"response.output_text.delta","delta":{"private":"` + observationSecret + `"}}`, "none"},
+		{`{"type":"response.content_part.added","part":{"type":"reasoning_text","text":"` + observationSecret + `"}}`, "none"},
+		{`{"type":"response.output_text.delta","delta":""}`, "empty_only"},
+		{`{"type":"response.output_text.done","text":" "}`, "nonempty"},
+		{`{"type":"response.content_part.done","part":{"type":"output_text","text":"` + observationSecret + `"}}`, "nonempty"},
+		{`{"type":"response.output_item.done","item":{"type":"message","content":[{"type":"output_text","text":"` + observationSecret + `"}]}}`, "nonempty"},
+	} {
+		d := NewCodexStreamObservation()
+		d.Observe([]byte("data: " + tc.data))
+		if d.outputTextState != tc.want {
+			t.Fatal("an upstream text snapshot lost its fixed category")
+		}
+	}
+}
