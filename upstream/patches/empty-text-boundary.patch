diff --git a/internal/translator/codex/claude/codex_empty_text_test.go b/internal/translator/codex/claude/codex_empty_text_test.go
new file mode 100644
--- /dev/null
+++ b/internal/translator/codex/claude/codex_empty_text_test.go
@@ -0,0 +1,115 @@
+package claude
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/tidwall/gjson"
+)
+
+func emptyTextFixture(events ...string) string {
+	var state any
+	var result strings.Builder
+	for _, event := range events {
+		for _, chunk := range ConvertCodexResponseToClaude(context.Background(), "gpt-6.1-sol", nil, nil,
+			[]byte("data: "+event), &state) {
+			result.Write(chunk)
+		}
+	}
+	return result.String()
+}
+
+func TestBridgeEmptyTextDoesNotClaimDeliveryOrCompletion(t *testing.T) {
+	for _, tail := range [][]string{
+		{`{"type":"response.content_part.added","output_index":0,"content_index":0,"part":{"type":"output_text","text":""}}`},
+		{`{"type":"response.output_text.delta","output_index":0,"content_index":0,"delta":""}`},
+		{`{"type":"response.content_part.added","output_index":0,"content_index":0,"part":{"type":"output_text","text":""}}`,
+			`{"type":"response.output_text.delta","output_index":0,"content_index":0,"delta":""}`},
+	} {
+		events := append([]string{`{"type":"response.created","response":{"id":"owned-empty","model":"gpt-6.1-sol"}}`}, tail...)
+		events = append(events, `{"type":"error","error":{"type":"server_error","message":"Owned failed stream"}}`)
+		out := emptyTextFixture(events...)
+		if strings.Contains(out, `"type":"text"`) || strings.Contains(out, `"type":"text_delta"`) ||
+			strings.Contains(out, "message_stop") || strings.Contains(out, "message_delta") || !strings.Contains(out, "event: error") {
+			t.Fatal("an empty unfinished answer claimed content or successful completion")
+		}
+	}
+}
+
+func TestBridgeEmptyDeltaPreservesWholeMessageFallback(t *testing.T) {
+	content := collectCitationStream(t, []string{
+		`{"type":"response.output_item.added","output_index":0,"item":{"type":"message","role":"assistant","content":[]}}`,
+		`{"type":"response.content_part.added","output_index":0,"content_index":0,"part":{"type":"output_text","text":""}}`,
+		`{"type":"response.output_text.delta","output_index":0,"content_index":0,"delta":""}`,
+		`{"type":"response.output_item.done","output_index":0,"item":{"type":"message","role":"assistant","content":[{"type":"output_text","text":"Retained answer."}]}}`,
+		`{"type":"response.completed","response":{"output":[]}}`,
+	})
+	if gjson.GetBytes(content, "#").Int() != 1 || gjson.GetBytes(content, "0.text").String() != "Retained answer." {
+		t.Fatal("an empty delta discarded or duplicated the whole-message answer")
+	}
+}
+
+func TestBridgeEmptyPartPreservesEarlyCitationAndDedup(t *testing.T) {
+	part := `{"type":"output_text","text":"Fixture answer.","annotations":[` + urlCitationFixture + `]}`
+	item := `{"type":"message","role":"assistant","content":[` + part + `]}`
+	annotation := `{"type":"response.output_text.annotation.added","output_index":0,"content_index":0,"annotation":` + urlCitationFixture + `}`
+	content := collectCitationStream(t, []string{
+		`{"type":"response.content_part.added","output_index":0,"content_index":0,"part":{"type":"output_text","text":""}}`,
+		annotation, annotation,
+		`{"type":"response.output_text.delta","output_index":0,"content_index":0,"delta":"Fixture answer."}`,
+		`{"type":"response.content_part.done","output_index":0,"content_index":0,"part":` + part + `}`,
+		annotation,
+		`{"type":"response.output_item.done","output_index":0,"item":` + item + `}`,
+		`{"type":"response.completed","response":{"output":[` + item + `]}}`,
+	})
+	block := gjson.GetBytes(content, "0")
+	if gjson.GetBytes(content, "#").Int() != 1 || block.Get("text").String() != "Fixture answer." || block.Get("citations.#").Int() != 1 {
+		t.Fatal("early or repeated annotations lost text, duplicated a block, or changed citation count")
+	}
+	// The citation represents only the prefix available when it was emitted;
+	// an early citation is not a binding to later, not-yet-generated text.
+	replayed := replayCodexURLCitations(block)
+	if gjson.GetBytes(replayed, "#").Int() != 1 ||
+		string(canonicalCodexURLCitation(gjson.GetBytes(replayed, "0"))) != string(canonicalCodexURLCitation(gjson.Parse(urlCitationFixture))) {
+		t.Fatal("the native URL annotation did not survive the early-content boundary")
+	}
+}
+
+func TestBridgeInvalidEarlyCitationDoesNotClaimDelivery(t *testing.T) {
+	out := emptyTextFixture(
+		`{"type":"response.content_part.added","part":{"type":"output_text","text":""}}`,
+		`{"type":"response.output_text.annotation.added","annotation":{"type":"url_citation","url":"javascript:invalid"}}`,
+	)
+	if strings.Contains(out, "content_block_start") {
+		t.Fatal("an invalid annotation opened an empty text block")
+	}
+}
+
+func TestBridgeWhitespaceDeltaRemainsRealContent(t *testing.T) {
+	content := collectCitationStream(t, []string{
+		`{"type":"response.content_part.added","part":{"type":"output_text","text":""}}`,
+		`{"type":"response.output_text.delta","delta":" "}`,
+		`{"type":"response.output_item.done","item":{"type":"message","content":[{"type":"output_text","text":"must not replace the delta"}]}}`,
+		`{"type":"response.completed","response":{"output":[]}}`,
+	})
+	if gjson.GetBytes(content, "#").Int() != 1 || gjson.GetBytes(content, "0.text").String() != " " {
+		t.Fatal("a nonempty whitespace delta was dropped or replaced")
+	}
+}
+
+func TestBridgeUnmappedNativeOutputKeepsPriorEmptyTextBoundary(t *testing.T) {
+	empty := `{"type":"response.content_part.added","part":{"type":"output_text","text":""}}`
+	for _, kind := range []string{"image_generation_call", "owned_future_output"} {
+		for _, stage := range []string{"added", "done"} {
+			item := `{"type":"response.output_item.` + stage + `","item":{"type":"` + kind + `","status":"completed"}}`
+			for _, events := range [][]string{{item, empty}, {empty, item},
+				{item, `{"type":"response.output_text.delta","delta":""}`}} {
+				out := emptyTextFixture(events...)
+				if !strings.Contains(out, `"type":"text"`) || strings.Contains(out, "message_stop") {
+					t.Fatal("unmapped native output extended recovery beyond the prior delivery boundary")
+				}
+			}
+		}
+	}
+}
