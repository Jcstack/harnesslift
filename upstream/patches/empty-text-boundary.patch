+// Observe only whether upstream text was absent, empty, or nonempty. This is
+// not a claim about client delivery, useful progress, tokens, or safe replay.
+func (d *CodexStreamObservation) observeOutputText(data []byte, event string) {
+	note := func(value gjson.Result) {
+		if value.Type != gjson.String {
+			return
+		}
+		if value.String() != "" {
+			d.outputTextState = "nonempty"
+		} else if d.outputTextState != "nonempty" {
+			d.outputTextState = "empty_only"
+		}
+	}
+	part := func(value gjson.Result) {
+		if value.Get("type").String() == "output_text" {
+			note(value.Get("text"))
+		}
+	}
+	switch event {
+	case "response.output_text.delta":
+		note(gjson.GetBytes(data, "delta"))
+	case "response.output_text.done":
+		note(gjson.GetBytes(data, "text"))
+	case "response.content_part.added", "response.content_part.done":
+		part(gjson.GetBytes(data, "part"))
+	case "response.output_item.done":
+		item := gjson.GetBytes(data, "item")
+		if item.Get("type").String() == "message" {
+			item.Get("content").ForEach(func(_, value gjson.Result) bool { part(value); return true })
+		}
 	}
 }
 
